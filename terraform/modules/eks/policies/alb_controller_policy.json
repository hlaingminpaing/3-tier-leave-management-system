{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Effect": "Allow",
      "Action": [
        "elbv2:CreateLoadBalancer",
        "elbv2:CreateTargetGroup",
        "elbv2:CreateListener",
        "elbv2:DeleteListener",
        "elbv2:DeleteLoadBalancer",
        "elbv2:DeleteTargetGroup",
        "elbv2:DescribeLoadBalancers",
        "elbv2:DescribeLoadBalancerAttributes",
        "elbv2:ModifyLoadBalancerAttributes",
        "elbv2:DescribeListeners",
        "elbv2:DescribeListenerCertificates",
        "elbv2:DescribeSSLPolicies",
        "elbv2:DescribeRules",
        "elbv2:DescribeTargetGroups",
        "elbv2:DescribeTargetGroupAttributes",
        "elbv2:DescribeTargetHealth",
        "elbv2:ModifyTargetGroupAttributes",
        "elbv2:RegisterTargets",
        "elbv2:DeregisterTargets",
        "elbv2:ModifyListener",
        "elbv2:ModifyRule",
        "elbv2:CreateRule",
        "elbv2:DeleteRule"
      ],
      "Resource": "*"
    },
    {
      "Effect": "Allow",
      "Action": [
        "ec2:DescribeInternetGateways",
        "ec2:DescribeSecurityGroups",
        "ec2:DescribeSecurityGroupRules",
        "ec2:DescribeInstances",
        "ec2:DescribeNetworkInterfaces",
        "ec2:DescribeTags",
        "ec2:DescribeVpcs",
        "ec2:DescribeSubnets"
      ],
      "Resource": "*"
    },
    {
      "Effect": "Allow",
      "Action": [
        "acm:DescribeCertificate",
        "acm:ListCertificates",
        "acm:ListTagsForCertificate"
      ],
      "Resource": "*"
    }
  ]
}
